// ABCtrees_expansion_deme.slim
//
// Simplified forward-only model for continuing from a burn-in tree sequence.
// Demographic history is provided as a generic epoch schedule derived from a demes YAML.
//
// Required -d parameters:
//   ID, gmu, imu, gd, id, gdfe, idfe
//
// Optional -d parameters:
//   INITTREES (default "")
//   INITIAL_SIZE (default NPOP)
//   EVENT_TIMES (default c())  // forward generations at which size changes occur
//   EVENT_SIZES (default c())  // target sizes paired with EVENT_TIMES
//   END (default 40000)
//   OUTTREES (default ".")
//   SIMPLIFY_INTERVAL (default 200)
//   NPOP (default computed from NE_REAL/Q; only used if INITTREES is empty)
//   SELF (default 0.98)
//   Q (default 50)
//   NE_REAL (default 300000)
//   R_REAL (default 4e-8)
//   GENOMEINFO_DIR (default "genomeinfo")
//   GENEFILE (overrides GENOMEINFO_DIR)
//   INTERFILE (overrides GENOMEINFO_DIR)

initialize() {
    if (!exists("Q")) defineConstant("Q", 50.0);
    if (!exists("NE_REAL")) defineConstant("NE_REAL", 300000.0);
    if (!exists("R_REAL")) defineConstant("R_REAL", 4e-8);

    if (!exists("END")) defineConstant("END", 40000);
    if (!exists("OUTTREES")) defineConstant("OUTTREES", ".");
    if (!exists("SIMPLIFY_INTERVAL")) defineConstant("SIMPLIFY_INTERVAL", 200);
    if (!exists("SELF")) defineConstant("SELF", 0.98);
    if (!exists("NPOP")) defineConstant("NPOP", asInteger(round(NE_REAL / Q)));
    if (!exists("INITTREES")) defineConstant("INITTREES", "");
    if (!exists("INITIAL_SIZE")) defineConstant("INITIAL_SIZE", NPOP);
    if (!exists("EVENT_TIMES")) defineConstant("EVENT_TIMES", c());
    if (!exists("EVENT_SIZES")) defineConstant("EVENT_SIZES", c());

    if (size(EVENT_TIMES) != size(EVENT_SIZES))
        stop("EVENT_TIMES and EVENT_SIZES must have the same length.");

    if (!exists("GENOMEINFO_DIR")) defineConstant("GENOMEINFO_DIR", "genomeinfo");
    if (!exists("GENEFILE"))
        defineConstant("GENEFILE", paste(GENOMEINFO_DIR, "/gene100.csv", sep=""));
    if (!exists("INTERFILE"))
        defineConstant("INTERFILE", paste(GENOMEINFO_DIR, "/intergene100.csv", sep=""));

    genes = readFile(GENEFILE);
    gene_starts = NULL;
    gene_stops = NULL;

    for (line in genes) {
        components = strsplit(line, ",");
        if (size(components) < 2) next;

        start = asInteger(components[0]);
        stop = asInteger(components[1]);
        if (isNULL(start) | isNULL(stop)) next;

        gene_starts = c(gene_starts, start);
        gene_stops = c(gene_stops, stop);
    }

    intergenes = readFile(INTERFILE);
    inter_starts = NULL;
    inter_stops = NULL;

    for (line in intergenes) {
        components = strsplit(line, ",");
        if (size(components) < 2) next;

        start = asInteger(components[0]);
        stop = asInteger(components[1]);
        if (isNULL(start) | isNULL(stop)) next;

        inter_starts = c(inter_starts, start);
        inter_stops = c(inter_stops, stop);
    }

    defineConstant("L", max(c(gene_stops, inter_stops)) + 1);

    initializeSLiMOptions(nucleotideBased=T);
    initializeTreeSeq();
    initializeAncestralNucleotides(randomNucleotides(L));

    gdfe_sim = gdfe * Q;
    idfe_sim = idfe * Q;

    initializeMutationTypeNuc("m2", 0.1, "g", gdfe_sim, 0.270);
    initializeMutationTypeNuc("m3", 0.1, "g", idfe_sim, 0.270);

    gd_eff = max(0.0, min(1.0, gd));
    id_eff = max(0.0, min(1.0, id));

    gmu_del_sim = (gmu * gd_eff) * Q;
    imu_del_sim = (imu * id_eff) * Q;

    initializeGenomicElementType("g1", m2, 1.0, mmJukesCantor(gmu_del_sim));
    initializeGenomicElementType("g2", m3, 1.0, mmJukesCantor(imu_del_sim));

    initializeGenomicElement(g1, gene_starts, gene_stops);
    initializeGenomicElement(g2, inter_starts, inter_stops);

    initializeRecombinationRate(R_REAL * Q);
}

mutation(m2) {
    if (mut.selectionCoeff < -1.0)
        mut.setSelectionCoeff(-1.0);
    return T;
}

mutation(m3) {
    if (mut.selectionCoeff < -1.0)
        mut.setSelectionCoeff(-1.0);
    return T;
}

1 late() {
    if (INITTREES != "") {
        sim.readFromPopulationFile(INITTREES);
        p1.setSelfingRate(SELF);
        if (p1.individualCount != INITIAL_SIZE)
            catn("Warning: loaded tree has " + p1.individualCount + " individuals, but YAML initial size is " + INITIAL_SIZE);
    } else {
        sim.addSubpop("p1", INITIAL_SIZE);
        p1.setSelfingRate(SELF);
    }
    sim.setValue("start_tick", community.tick);
}

1:200000 late() {
    gen = community.tick;
    elapsed = gen - sim.getValue("start_tick") + 1;

    if (elapsed % 5000 == 0)
        catn("Heartbeat: continuation generation " + elapsed + " (absolute tick " + gen + ") for ID " + ID);

    if (size(EVENT_TIMES) > 0) {
        for (i in seqAlong(EVENT_TIMES)) {
            if (elapsed == EVENT_TIMES[i]) {
                p1.setSubpopulationSize(asInteger(EVENT_SIZES[i]));
                catn("Applied demographic event at continuation generation " + elapsed + " with size " + asInteger(EVENT_SIZES[i]) + " for ID " + ID);
            }
        }
    }

    if (SIMPLIFY_INTERVAL > 0) {
        if (gen % SIMPLIFY_INTERVAL == 0)
            sim.treeSeqSimplify();
    }

    if (elapsed == END) {
        catn("Simulation reached continuation generation " + END + " for ID " + ID);

        sim.treeSeqSimplify();
        sim.treeSeqOutput(paste(OUTTREES, "/", ID, ".trees", sep=""));
        sim.simulationFinished();
    }
}
